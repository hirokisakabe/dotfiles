[user]
name = Hiroki SAKABE
email = hiroki.sakabe@icloud.com

[alias]
gg = "log --graph --pretty=oneline"
# stash -> デフォルトブランチに移動 -> pull -> 元ブランチ削除 -> stash pop
sdd = "!f() { CURRENT_BRANCH=$(git symbolic-ref --short HEAD); DEFAULT_BRANCH=$(git config default.branch); git stash; git checkout $DEFAULT_BRANCH; git pull; git branch -D $CURRENT_BRANCH; git stash pop; }; f"

[rebase]
autostash = true
abbreviateCommands = true
autosquash = true

[pull]
ff = only

# Verify received objects; fetch/receive are explicit even though transfer is a fallback.
[transfer]
fsckObjects = true

[fetch]
fsckObjects = true

[receive]
fsckObjects = true

[core]
excludesfile = ~/.gitignore_global
pager = delta
hooksPath = ~/.git-hooks

[interactive]
diffFilter = delta --color-only

[delta]
# Atrium Library palette
navigate = true
line-numbers = true
syntax-theme = ansi
minus-style = syntax "#f2e6e6"
minus-emph-style = syntax "#e8d2d2"
plus-style = syntax "#e8eee8"
plus-emph-style = syntax "#d6e2d6"
zero-style = syntax
line-numbers-minus-style = "#945f5f"
line-numbers-plus-style = "#687768"
line-numbers-left-style = "#737a7e"
line-numbers-right-style = "#737a7e"
line-numbers-zero-style = "#737a7e"
file-style = "#687078" bold
file-decoration-style = "#cbd1d4" ul
hunk-header-style = "#756d7a" bold
hunk-header-decoration-style = "#cbd1d4" box

[merge]
conflictStyle = zdiff3

[push]
autoSetupRemote = true

[init]
defaultBranch = main

[default]
branch = main

# GitAlias configuration
[include]
    path = ~/.git-extensions/gitalias.txt
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
