# Supply chain hardening for npm.
# Reference: https://docs.npmjs.com/cli/v10/configuring-npm/npmrc

# Block lifecycle scripts (preinstall/install/postinstall) during `npm install`.
# Mitigates supply-chain attacks that abuse install-time code execution.
# Override per-project in a project-local .npmrc when native builds are required
# (e.g., better-sqlite3, node-gyp based packages).
ignore-scripts=true

# Reduce noise from funding messages.
fund=false

# Publish 直後の悪意あるバージョン取り込みを避けるため、7 日経過したバージョンのみ install 対象とする。
# 要 npm >= 11.10.0 (https://docs.npmjs.com/cli/v11/using-npm/config#min-release-age)
min-release-age=7
